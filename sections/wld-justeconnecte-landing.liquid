{%- comment -%} ═══ JAVASCRIPT ═══ {%- endcomment -%}
<script>
(function() {
  'use strict';

  function initWldJc(scope) {
    var sid = '{{ sid }}';
    var root = scope || document.getElementById('wld-justeconnecte-' + sid);
    if (!root) return;

    /* ── Bundle selector ── */
    var allBtnGroups = root.querySelectorAll('.wldjc-bundles');
    allBtnGroups.forEach(function(group) {
      var zone = group.dataset.zone;
      var btns = group.querySelectorAll('.wldjc-bundle-btn');

      btns.forEach(function(btn, idx) {
        btn.addEventListener('click', function() {
          /* Sync active state across both zones */
          allBtnGroups.forEach(function(g) {
            g.querySelectorAll('.wldjc-bundle-btn').forEach(function(b, i) {
              b.classList.toggle('active', i === idx);
            });
          });

          /* Update variant hidden input + price display */
          var variantId  = btn.dataset.variant  || '';
          var price      = btn.dataset.price     || '';
          var oldPrice   = btn.dataset.oldPrice  || '';
          var qty        = btn.dataset.quantity  || '1';

          root.querySelectorAll('.js-variant-id').forEach(function(el) { el.value = variantId; });
          root.querySelectorAll('.js-variant-qty').forEach(function(el) { el.value = qty; });
          root.querySelectorAll('.js-current-price').forEach(function(el) { el.textContent = price; });
          root.querySelectorAll('.js-old-price').forEach(function(el) { el.textContent = oldPrice; el.style.display = oldPrice ? '' : 'none'; });
          root.querySelectorAll('.js-saving').forEach(function(el) { el.textContent = ''; });
        });
      });

      /* Init first bundle on load */
      if (btns.length) {
        var first = btns[0];
        root.querySelectorAll('.js-variant-id').forEach(function(el) { el.value = first.dataset.variant || ''; });
        root.querySelectorAll('.js-variant-qty').forEach(function(el) { el.value = first.dataset.quantity || '1'; });
      }
    });

    /* ── Scroll-to-buybox on hero CTA ── */
    root.querySelectorAll('.js-add-to-cart[data-zone="hero"]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var box = root.querySelector('#wldjc-buybox');
        if (box) box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* ── FAQ accordion ── */
    root.querySelectorAll('.js-faq-toggle').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var answer   = btn.nextElementSibling;
        btn.setAttribute('aria-expanded', !expanded);
        if (!expanded) { answer.removeAttribute('hidden'); }
        else           { answer.setAttribute('hidden', ''); }
      });
    });
  }

  /* Init on DOMContentLoaded */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { initWldJc(); });
  } else {
    initWldJc();
  }

  /* Re-init on Shopify section reload */
  document.addEventListener('shopify:section:load', function(e) {
    var scope = e.target.querySelector('#wld-justeconnecte-{{ sid }}');
    if (scope) initWldJc(scope);
  });
})();
</script>

