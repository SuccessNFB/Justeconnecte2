{% assign slug = 'justeconnecte' %}
{% assign sid = section.id %}
{% assign prod = section.settings.product %}

{% if prod == blank %}
  <div id="vel-no-product-notice" style="background:#fff3cd;border:1px solid #ffc107;color:#856404;padding:16px 24px;text-align:center;font-family:sans-serif;">
    ⚠️ <strong>WLD — JusteConnecté Landing :</strong> Aucun produit sélectionné. Allez dans l'éditeur de thème → Settings → Produit pour assigner votre produit.
  </div>
{% endif %}

<div id="wld-{{ slug }}-{{ sid }}">

  {%- comment -%} ═══ 1. HERO ═══ {%- endcomment -%}
  <section class="wldjc-hero">
    <div class="wldjc-hero__inner wldjc-container">
      <div class="wldjc-hero__text">
        {% if section.settings.badge_text != blank %}
          <span class="wldjc-badge">{{ section.settings.badge_text }}</span>
        {% endif %}
        <h1 class="wldjc-h1">{{ section.settings.hero_title }}</h1>
        <p class="wldjc-hero__sub">{{ section.settings.hero_subtitle }}</p>

        <div class="wldjc-stars" aria-label="{{ section.settings.review_count }} avis">
          <span class="wldjc-stars__icons">★★★★★</span>
          <span class="wldjc-stars__label">{{ section.settings.hero_rating }} — {{ section.settings.review_count }}</span>
        </div>

        {%- comment -%} Hero bundle selector {%- endcomment -%}
        <div class="wldjc-bundles" data-zone="hero">
          {% for block in section.blocks %}
            {% if block.type == 'bundle' %}
              <button
                class="wldjc-bundle-btn{% if forloop.first %} active{% endif %}"
                data-variant="{{ block.settings.variant_id }}"
                data-price="{{ block.settings.price }}"
                data-old-price="{{ block.settings.old_price }}"
                data-quantity="{{ block.settings.quantity }}"
                data-zone="hero"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.popular %}<span class="wldjc-bundle-popular">{{ section.settings.popular_label }}</span>{% endif %}
                <strong>{{ block.settings.label }}</strong>
                <span class="wldjc-bundle-qty">{{ block.settings.quantity_label }}</span>
                <span class="wldjc-bundle-price">{{ block.settings.price }}</span>
                {% if block.settings.old_price != blank %}
                  <s class="wldjc-bundle-old">{{ block.settings.old_price }}</s>
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>

        <button class="wldjc-cta wldjc-cta--hero js-add-to-cart" data-zone="hero">
          {{ section.settings.cta_hero }}
        </button>
        <p class="wldjc-guarantee-line">🔒 {{ section.settings.guarantee_short }}</p>
      </div>

      <div class="wldjc-hero__media">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 900 | image_tag: loading: 'eager', alt: section.settings.hero_title, class: 'wldjc-hero__img' }}
        {% else %}
          <div class="wldjc-hero__img-placeholder">{{ 'product-1' | placeholder_svg_tag: 'wldjc-placeholder-svg' }}</div>
        {% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 2. TRUST STRIP ═══ {%- endcomment -%}
  <section class="wldjc-trust-strip">
    <div class="wldjc-container wldjc-trust-strip__inner">
      <div class="wldjc-trust-strip__item">
        <span class="wldjc-trust-strip__icon">🚚</span>
        <span>{{ section.settings.trust_1 }}</span>
      </div>
      <div class="wldjc-trust-strip__item">
        <span class="wldjc-trust-strip__icon">🔄</span>
        <span>{{ section.settings.trust_2 }}</span>
      </div>
      <div class="wldjc-trust-strip__item">
        <span class="wldjc-trust-strip__icon">🛡️</span>
        <span>{{ section.settings.trust_3 }}</span>
      </div>
      <div class="wldjc-trust-strip__item">
        <span class="wldjc-trust-strip__icon">⭐</span>
        <span>{{ section.settings.trust_4 }}</span>
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 3. PROBLÈME → SOLUTION ═══ {%- endcomment -%}
  <section class="wldjc-problem">
    <div class="wldjc-container wldjc-problem__inner">
      <div class="wldjc-problem__text">
        <p class="wldjc-overline">{{ section.settings.problem_overline }}</p>
        <h2 class="wldjc-h2">{{ section.settings.problem_title }}</h2>
        <p class="wldjc-body">{{ section.settings.problem_body }}</p>
        <h3 class="wldjc-h3 wldjc-solution-title">{{ section.settings.solution_title }}</h3>
        <p class="wldjc-body">{{ section.settings.solution_body }}</p>
      </div>
      <div class="wldjc-problem__media">
        {% if section.settings.problem_image != blank %}
          {{ section.settings.problem_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.problem_title, class: 'wldjc-rounded' }}
        {% else %}
          <div class="wldjc-placeholder-block">{{ 'lifestyle-1' | placeholder_svg_tag: 'wldjc-placeholder-svg' }}</div>
        {% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 4. BÉNÉFICES ═══ {%- endcomment -%}
  <section class="wldjc-benefits">
    <div class="wldjc-container">
      <p class="wldjc-overline wldjc-center">{{ section.settings.benefits_overline }}</p>
      <h2 class="wldjc-h2 wldjc-center">{{ section.settings.benefits_title }}</h2>
      <div class="wldjc-benefits__grid">
        {% for i in (1..6) %}
          {% assign icon_key = 'benefit_' | append: i | append: '_icon' %}
          {% assign title_key = 'benefit_' | append: i | append: '_title' %}
          {% assign body_key = 'benefit_' | append: i | append: '_body' %}
          {% if section.settings[title_key] != blank %}
            <div class="wldjc-benefit-card">
              <div class="wldjc-benefit-card__icon">{{ section.settings[icon_key] }}</div>
              <h4 class="wldjc-benefit-card__title">{{ section.settings[title_key] }}</h4>
              <p class="wldjc-benefit-card__body">{{ section.settings[body_key] }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 5. FEATURES / FORMULE ═══ {%- endcomment -%}
  <section class="wldjc-features">
    <div class="wldjc-container wldjc-features__inner">
      <div class="wldjc-features__media">
        {% if section.settings.features_image != blank %}
          {{ section.settings.features_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.features_title, class: 'wldjc-rounded' }}
        {% else %}
          <div class="wldjc-placeholder-block">{{ 'product-2' | placeholder_svg_tag: 'wldjc-placeholder-svg' }}</div>
        {% endif %}
      </div>
      <div class="wldjc-features__text">
        <p class="wldjc-overline">{{ section.settings.features_overline }}</p>
        <h2 class="wldjc-h2">{{ section.settings.features_title }}</h2>
        <ul class="wldjc-checklist">
          {% for i in (1..6) %}
            {% assign feat_key = 'feature_' | append: i %}
            {% if section.settings[feat_key] != blank %}
              <li class="wldjc-checklist__item">
                <span class="wldjc-checklist__check">✓</span>
                {{ section.settings[feat_key] }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 6. COMPARAISON ═══ {%- endcomment -%}
  <section class="wldjc-comparison">
    <div class="wldjc-container">
      <h2 class="wldjc-h2 wldjc-center">{{ section.settings.comparison_title }}</h2>
      <div class="wldjc-comparison__table-wrap">
        <table class="wldjc-comparison__table">
          <thead>
            <tr>
              <th></th>
              <th class="wldjc-comparison__ours">{{ section.settings.comparison_col_ours }}</th>
              <th class="wldjc-comparison__others">{{ section.settings.comparison_col_others }}</th>
            </tr>
          </thead>
          <tbody>
            {% for i in (1..7) %}
              {% assign row_key = 'comparison_row_' | append: i %}
              {% assign our_key = 'comparison_ours_' | append: i %}
              {% assign other_key = 'comparison_other_' | append: i %}
              {% if section.settings[row_key] != blank %}
                <tr>
                  <td class="wldjc-comparison__feature">{{ section.settings[row_key] }}</td>
                  <td class="wldjc-comparison__ours wldjc-check">{{ section.settings[our_key] | default: '✓' }}</td>
                  <td class="wldjc-comparison__others wldjc-cross">{{ section.settings[other_key] | default: '✗' }}</td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 7. TÉMOIGNAGES ═══ {%- endcomment -%}
  <section class="wldjc-reviews">
    <div class="wldjc-container">
      <p class="wldjc-overline wldjc-center">{{ section.settings.reviews_overline }}</p>
      <h2 class="wldjc-h2 wldjc-center">{{ section.settings.reviews_title }}</h2>
      <div class="wldjc-reviews__grid">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="wldjc-review-card" {{ block.shopify_attributes }}>
              <div class="wldjc-review-card__stars">★★★★★</div>
              <p class="wldjc-review-card__body">"{{ block.settings.review_text }}"</p>
              <div class="wldjc-review-card__author">
                {% if block.settings.review_avatar != blank %}
                  {{ block.settings.review_avatar | image_url: width: 60 | image_tag: loading: 'lazy', alt: block.settings.review_name, class: 'wldjc-review-card__avatar' }}
                {% else %}
                  <div class="wldjc-review-card__avatar-placeholder">{{ block.settings.review_name | slice: 0 }}</div>
                {% endif %}
                <div>
                  <strong>{{ block.settings.review_name }}</strong>
                  <span class="wldjc-review-card__meta">{{ block.settings.review_meta }}</span>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 8. BUY BOX ═══ {%- endcomment -%}
  <section class="wldjc-buybox" id="wldjc-buybox">
    <div class="wldjc-container wldjc-buybox__inner">
      <div class="wldjc-buybox__media">
        {% if section.settings.buybox_image != blank %}
          {{ section.settings.buybox_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.buybox_title, class: 'wldjc-rounded' }}
        {% elsif section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.buybox_title, class: 'wldjc-rounded' }}
        {% else %}
          <div class="wldjc-placeholder-block">{{ 'product-3' | placeholder_svg_tag: 'wldjc-placeholder-svg' }}</div>
        {% endif %}
      </div>
      <div class="wldjc-buybox__text">
        <h2 class="wldjc-h2">{{ section.settings.buybox_title }}</h2>
        <p class="wldjc-body">{{ section.settings.buybox_subtitle }}</p>

        <div class="wldjc-bundles" data-zone="buybox">
          {% for block in section.blocks %}
            {% if block.type == 'bundle' %}
              <button
                class="wldjc-bundle-btn{% if forloop.first %} active{% endif %}"
                data-variant="{{ block.settings.variant_id }}"
                data-price="{{ block.settings.price }}"
                data-old-price="{{ block.settings.old_price }}"
                data-quantity="{{ block.settings.quantity }}"
                data-zone="buybox"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.popular %}<span class="wldjc-bundle-popular">{{ section.settings.popular_label }}</span>{% endif %}
                <strong>{{ block.settings.label }}</strong>
                <span class="wldjc-bundle-qty">{{ block.settings.quantity_label }}</span>
                <span class="wldjc-bundle-price">{{ block.settings.price }}</span>
                {% if block.settings.old_price != blank %}
                  <s class="wldjc-bundle-old">{{ block.settings.old_price }}</s>
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>

        <div class="wldjc-price-display">
          <span class="wldjc-price-display__current js-current-price">{{ section.settings.default_price }}</span>
          <span class="wldjc-price-display__old js-old-price">{{ section.settings.default_old_price }}</span>
          <span class="wldjc-price-display__saving js-saving"></span>
        </div>

        <form action="/cart/add" method="post" class="wldjc-cart-form">
          <input type="hidden" name="id" class="js-variant-id" value="">
          <input type="hidden" name="quantity" class="js-variant-qty" value="1">
          <button type="submit" class="wldjc-cta wldjc-cta--buybox js-add-to-cart" data-zone="buybox">
            {{ section.settings.cta_buybox }}
          </button>
        </form>

        <ul class="wldjc-buybox__trust">
          <li>🔒 {{ section.settings.buybox_trust_1 }}</li>
          <li>📦 {{ section.settings.buybox_trust_2 }}</li>
          <li>🔄 {{ section.settings.buybox_trust_3 }}</li>
        </ul>

        <div class="wldjc-payment-icons">
          <span>Visa</span><span>Mastercard</span><span>Amex</span><span>PayPal</span><span>Apple Pay</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 9. FAQ ═══ {%- endcomment -%}
  <section class="wldjc-faq">
    <div class="wldjc-container">
      <p class="wldjc-overline wldjc-center">{{ section.settings.faq_overline }}</p>
      <h2 class="wldjc-h2 wldjc-center">{{ section.settings.faq_title }}</h2>
      <div class="wldjc-faq__list">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <div class="wldjc-faq__item" {{ block.shopify_attributes }}>
              <button class="wldjc-faq__q js-faq-toggle" aria-expanded="false">
                {{ block.settings.question }}
                <span class="wldjc-faq__icon" aria-hidden="true">+</span>
              </button>
              <div class="wldjc-faq__a" hidden>
                {{ block.settings.answer }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ═══ 10. CTA FINAL ═══ {%- endcomment -%}
  <section class="wldjc-final-cta">
    <div class="wldjc-container wldjc-center">
      <h2 class="wldjc-h2">{{ section.settings.final_cta_title }}</h2>
      <p class="wldjc-body">{{ section.settings.final_cta_body }}</p>
      <a href="#wldjc-buybox" class="wldjc-cta wldjc-cta--final">{{ section.settings.final_cta_btn }}</a>
    </div>
  </section>

</div>

{%- comment -%} ═══ CSS ═══ {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');

  #wld-{{ slug }}-{{ sid }} {
    --jc-primary:    {{ section.settings.color_primary }};
    --jc-secondary:  {{ section.settings.color_secondary }};
    --jc-bg:         {{ section.settings.color_bg }};
    --jc-surface:    {{ section.settings.color_surface }};
    --jc-text:       {{ section.settings.color_text }};
    --jc-text-muted: {{ section.settings.color_muted }};
    --jc-border:     {{ section.settings.color_border }};
    --jc-radius:     12px;
    --jc-shadow:     0 4px 24px rgba(0,0,0,.08);
    font-family: 'Inter', sans-serif;
    color: var(--jc-text);
    background: var(--jc-bg);
    box-sizing: border-box;
  }
  #wld-{{ slug }}-{{ sid }} *, #wld-{{ slug }}-{{ sid }} *::before, #wld-{{ slug }}-{{ sid }} *::after { box-sizing: inherit; }

  /* Layout */
  #wld-{{ slug }}-{{ sid }} .wldjc-container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  #wld-{{ slug }}-{{ sid }} .wldjc-center { text-align: center; }

  /* Typography */
  #wld-{{ slug }}-{{ sid }} .wldjc-h1 { font-family: 'DM Serif Display', serif; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.15; color: var(--jc-text); margin: 0 0 .75em; }
  #wld-{{ slug }}-{{ sid }} .wldjc-h2 { font-family: 'DM Serif Display', serif; font-size: clamp(1.6rem, 3.5vw, 2.6rem); line-height: 1.2; color: var(--jc-text); margin: 0 0 .6em; }
  #wld-{{ slug }}-{{ sid }} .wldjc-h3 { font-family: 'DM Serif Display', serif; font-size: clamp(1.2rem, 2.5vw, 1.8rem); color: var(--jc-text); margin: 1em 0 .4em; }
  #wld-{{ slug }}-{{ sid }} .wldjc-body { font-size: 1.05rem; line-height: 1.7; color: var(--jc-text-muted); margin: 0 0 1em; }
  #wld-{{ slug }}-{{ sid }} .wldjc-overline { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--jc-primary); margin: 0 0 .5em; }
  #wld-{{ slug }}-{{ sid }} .wldjc-rounded { border-radius: var(--jc-radius); width: 100%; height: auto; display: block; }
  #wld-{{ slug }}-{{ sid }} .wldjc-placeholder-block svg { width: 100%; height: auto; border-radius: var(--jc-radius); }

  /* Badge */
  #wld-{{ slug }}-{{ sid }} .wldjc-badge { display: inline-block; background: var(--jc-primary); color: #fff; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 4px 14px; border-radius: 999px; margin-bottom: 1rem; }

  /* Stars */
  #wld-{{ slug }}-{{ sid }} .wldjc-stars { display: flex; align-items: center; gap: 8px; margin-bottom: 1.25rem; flex-wrap: wrap; }
  #wld-{{ slug }}-{{ sid }} .wldjc-stars__icons { color: #f59e0b; font-size: 1.1rem; letter-spacing: 2px; }
  #wld-{{ slug }}-{{ sid }} .wldjc-stars__label { font-size: .9rem; color: var(--jc-text-muted); }

  /* CTA Buttons */
  #wld-{{ slug }}-{{ sid }} .wldjc-cta { display: inline-block; background: var(--jc-primary); color: #fff; font-weight: 700; font-size: 1.1rem; padding: 16px 36px; border-radius: var(--jc-radius); border: none; cursor: pointer; text-decoration: none; transition: opacity .2s, transform .15s; text-align: center; width: 100%; }
  #wld-{{ slug }}-{{ sid }} .wldjc-cta:hover { opacity: .9; transform: translateY(-2px); }
  #wld-{{ slug }}-{{ sid }} .wldjc-guarantee-line { font-size: .85rem; color: var(--jc-text-muted); margin-top: .75rem; }

  /* ─── HERO ─── */
  #wld-{{ slug }}-{{ sid }} .wldjc-hero { padding: 80px 0 60px; background: var(--jc-surface); }
  #wld-{{ slug }}-{{ sid }} .wldjc-hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  #wld-{{ slug }}-{{ sid }} .wldjc-hero__img { width: 100%; height: auto; border-radius: var(--jc-radius); box-shadow: var(--jc-shadow); }
  #wld-{{ slug }}-{{ sid }} .wldjc-hero__img-placeholder svg { width: 100%; height: auto; border-radius: var(--jc-radius); }
  #wld-{{ slug }}-{{ sid }} .wldjc-hero__sub { font-size: 1.15rem; line-height: 1.65; color: var(--jc-text-muted); margin-bottom: 1.5rem; }

  /* ─── BUNDLE SELECTOR ─── */
  #wld-{{ slug }}-{{ sid }} .wldjc-bundles { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem; }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-btn { position: relative; display: flex; align-items: center; gap: 12px; background: var(--jc-bg); border: 2px solid var(--jc-border); border-radius: var(--jc-radius); padding: 14px 18px; cursor: pointer; text-align: left; transition: border-color .2s, box-shadow .2s; font-family: inherit; flex-wrap: wrap; }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-btn.active { border-color: var(--jc-primary); box-shadow: 0 0 0 3px {{ section.settings.color_primary | color_modify: 'alpha', .15 }}; }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-btn strong { font-weight: 700; font-size: 1rem; color: var(--jc-text); flex: 1; }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-qty { font-size: .85rem; color: var(--jc-text-muted); }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-price { font-weight: 700; color: var(--jc-primary); font-size: 1.05rem; }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-old { font-size: .85rem; color: var(--jc-text-muted); }
  #wld-{{ slug }}-{{ sid }} .wldjc-bundle-popular { position: absolute; top: -11px; right: 14px; background: var(--jc-primary); color: #fff; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; }

  /* ─── TRUST STRIP ─── */
  #wld-{{ slug }}-{{ sid }} .wldjc-trust-strip { background: var(--jc-primary); padding: 20px 0; }
  #wld-{{ slug }}-{{ sid }} .wldjc-trust-strip__inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; }
  #wld-{{ slug }}-{{ sid }} .wldjc-trust-strip__item { display: flex; align-items: center; gap: 8px; color: #fff; font-weight: 600; font-size: .9rem; }
  #wld-{{ slug }}-{{ sid }} .wldjc-trust-strip__icon { font-size: 1.2rem; }

  /* ─── PROBLÈME / SOLUTION ─── */
  #wld-{{ slug }}-{{ sid }} .wldjc-problem { padding: 80px 0; }
  #wld-{{ slug }}-{{ sid }} .wldjc-problem__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  #wld-{{ slug }}-{{ sid }} .wldjc-solution-title { color: var(--jc-primary); }

  /* ─── BÉNÉFICES ─── */
  #wld-{{ slug }}-{{ sid }} .wldjc-benefits { padding: 80px 0; background: var(--jc-surface); }
  #wld-{{ slug }}-{{ sid }} .wldjc-benefits__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 3rem; }
  #wld-{{ slug }}-{{ sid }} .wldjc-benefit-card { background: var(--jc-bg); border: 1px solid var(--jc-border); border-radius: var(--jc-radius); padding: 28px 24px; text-align: center; transition: box-shadow .2s; }
  #wld-{{ slug }}-{{ sid }} .wldjc-benefit-card:hover { box-shadow: var(--jc-shadow); }
  #wld-{{ slug }}-{{ sid }} .wldjc-benefit-card__icon { font-size: 2.2rem; margin-bottom: .75rem; }
  #wld-{{ slug }}-{{ sid }} .wldjc-benefit-card__title { font-weight: 700; font-size: 1.05rem; margin: 0 0 .5rem; }
  #wld-{{ slug }}-{{ sid }} .wldjc-benefit-card__body { font-size: .9rem; color: var(--jc-text-muted); margin: 0; }

  /* ─── FEATURES ─── */
  #wld-{{ slug }}-{{ sid }} .wldjc-features { padding: 80px 0; }
  #wld-{{ slug }}-{{ sid }} .wldjc-features__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
